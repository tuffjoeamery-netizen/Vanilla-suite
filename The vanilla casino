        </div>
        <button class="action-btn-main sports-btn" id="book-btn" onclick="startSportsSim()" disabled>Lock Bet & Broadcast</button>
    </div>

    <!-- MODULE 2: BLACKJACK -->
    <div class="game-card" id="card-bj">
