            <div class="screen-text" id="screen-text">Select a sport and coordinate a wager stake to go live.</div>
        </div>
        <div class="sub-tabs">
            <button class="sub-tab-btn active" id="sub-horse" onclick="switchSport('horse')">🏇 Racing</button>
            <button class="sub-tab-btn" id="sub-football" onclick="switchSport('football')">⚽ Football</button>
            <button class="sub-tab-btn" id="sub-f1" onclick="switchSport('f1')">🏎️ F1</button>
        </div>
        <div class="market-title" id="market-headline">Available Markets:</div>
        <div class="odds-grid" id="odds-container"></div>
        <div class="slider-zone">
            <div class="slider-label"><span>Wager Amount:</span><strong><span id="wager-sports-txt">50</span> VC</strong></div>
