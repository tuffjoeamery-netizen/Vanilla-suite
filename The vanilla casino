<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Vanilla Casino & Sportsbook</title>
    <style>
        :root {
            --bg-color: #0b111e;       
            --card-bg: #151f32;       
            --primary: #38bdf8;       
            --amber: #f59e0b;         
            --text: #f8fafc;          
            --text-sub: #94a3b8;      
            --win-green: #10b981;     
            --loss-red: #ef4444;      
            --inner-bg: #0f172a;      
        }

        body {
            font-family: system-ui, -apple-system, sans-serif;
            background-color: var(--bg-color);
            color: var(--text);
            margin: 0;
            padding: 15px;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
            box-sizing: border-box;
            user-select: none;
            -webkit-user-select: none;
            -webkit-tap-highlight-color: transparent;
        }

        header { text-align: center; margin-bottom: 15px; }
        h1 { color: var(--primary); margin: 5px 0; font-size: 2.4rem; font-weight: 800; letter-spacing: -0.03em; }
        .subtitle { color: var(--text-sub); margin-top: 0; font-size: 0.95rem; }

        .hub-dashboard {
            background: linear-gradient(135deg, #151f32, #0f172a);
            padding: 15px 25px;
            border-radius: 16px;
            font-size: 1.4rem;
            font-weight: bold;
            margin-bottom: 15px;
            border: 1px solid rgba(56, 189, 248, 0.2);
            box-shadow: 0 4px 20px rgba(0,0,0,0.4);
            width: 100%;
            max-width: 460px;
            box-sizing: border-box;
            text-align: center;
        }
        .chip-count { color: var(--primary); font-variant-numeric: tabular-nums; }

        .global-stats {
            display: flex;
            gap: 10px;
            width: 100%;
            max-width: 460px;
            margin-bottom: 20px;
        }
        .stat-box {
            flex: 1;
            background: var(--card-bg);
            padding: 10px;
            border-radius: 10px;
            text-align: center;
            font-weight: bold;
            font-size: 0.85rem;
            border: 1px solid rgba(255,255,255,0.03);
        }

        .master-nav {
            display: flex;
            gap: 6px;
            width: 100%;
            max-width: 460px;
            background: #090d16;
            padding: 5px;
            border-radius: 12px;
            margin-bottom: 20px;
            border: 1px solid rgba(255,255,255,0.05);
        }
        .master-btn {
            flex: 1;
            background: transparent;
            color: var(--text-sub);
            border: none;
            padding: 12px 5px;
            font-size: 0.9rem;
            font-weight: bold;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .master-btn.active {
            background: var(--card-bg);
            color: var(--primary);
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
        }

        .game-card {
            background: var(--card-bg);
            border-radius: 24px;
            padding: 22px;
            width: 100%;
            max-width: 460px;
            box-sizing: border-box;
            box-shadow: 0 15px 35px rgba(0,0,0,0.5);
            border: 1px solid rgba(255,255,255,0.05);
            display: none; 
        }
        .game-card.active { display: block; }

        .slider-zone {
            background: rgba(0,0,0,0.25);
            padding: 14px;
            border-radius: 12px;
            margin-bottom: 18px;
            border: 1px solid rgba(255,255,255,0.02);
        }
        .slider-label {
            display: flex;
            justify-content: space-between;
            font-size: 0.9rem;
            color: var(--text-sub);
            margin-bottom: 6px;
        }
        .bet-slider {
            width: 100%;
            accent-color: var(--primary);
            cursor: pointer;
        }

        .live-screen {
            background-color: var(--inner-bg);
            border-radius: 14px;
            padding: 18px;
            min-height: 100px;
            margin-bottom: 18px;
            border: 1px solid #223147;
            box-shadow: inset 0 0 20px rgba(0,0,0,0.8);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
        }
        .screen-badge {
            background-color: var(--loss-red);
            color: white;
            font-size: 0.7rem;
            font-weight: bold;
            padding: 2px 7px;
            border-radius: 4px;
            text-transform: uppercase;
            margin-bottom: 8px;
            letter-spacing: 0.05em;
            display: none;
        }
        .screen-text {
            font-family: 'Courier New', Courier, monospace;
            font-size: 1.05rem;
            color: #38bdf8;
            font-weight: bold;
            line-height: 1.4;
        }
        .sub-tabs {
            display: flex;
            gap: 4px;
            margin-bottom: 15px;
            background: #090d16;
            padding: 4px;
            border-radius: 8px;
        }
        .sub-tab-btn {
            flex: 1;
            background: transparent;
            color: var(--text-sub);
            padding: 8px 2px;
            font-size: 0.8rem;
            font-weight: bold;
            border-radius: 6px;
            border: none;
            cursor: pointer;
        }
        .sub-tab-btn.active {
            background: var(--card-bg);
            color: var(--amber);
        }
        .market-title { font-size: 0.85rem; color: var(--text-sub); margin-bottom: 8px; font-weight: 600; }
        .odds-grid { display: flex; flex-direction: column; gap: 8px; margin-bottom: 18px; }
        .odds-row {
            background: #0f172a;
            padding: 12px;
            border-radius: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border: 1px solid transparent;
            cursor: pointer;
        }
        .odds-row.selected {
            border-color: var(--amber);
            background: rgba(245, 158, 11, 0.08);
        }
        .odds-value {
            background: #223147;
            color: var(--amber);
            padding: 4px 10px;
            border-radius: 6px;
            font-weight: bold;
            font-size: 0.85rem;
            min-width: 40px;
            text-align: center;
        }
        .odds-row.selected .odds-value { background: var(--amber); color: #0b111e; }
        .action-btn-main {
            background: var(--primary); color: #0b111e; font-size: 1.1rem; font-weight: 800;
            padding: 16px; border-radius: 14px; border: none; width: 100%; cursor: pointer;
            box-shadow: 0 4px 14px rgba(56, 189, 248, 0.15);
        }
        .action-btn-main:disabled { background: #223147!important; color: #475569!important; box-shadow: none; cursor: not-allowed; }
        .sports-btn { background: var(--amber); }

        .table-felt {
            background: var(--inner-bg);
            border-radius: 14px;
            padding: 16px;
            margin-bottom: 18px;
            border: 1px solid rgba(255, 255, 255, 0.04);
        }
        .hand-section { margin-bottom: 15px; text-align: left; }
        .hand-label { font-size: 0.8rem; color: var(--text-sub); text-transform: uppercase; margin-bottom: 6px; }
        .card-row { font-size: 1.7rem; font-weight: bold; min-height: 44px; display: flex; gap: 8px; }
        .playing-card { background: white; color: #0b111e; padding: 4px 10px; border-radius: 6px; box-shadow: 0 3px 6px rgba(0,0,0,0.4); }
        .card-red { color: var(--loss-red); }
        .bj-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .split-btn { padding: 15px; font-size: 1rem; font-weight: bold; border-radius: 12px; border: none; color: white; cursor: pointer; }
        #hit-btn { background: var(--win-green); }
        #stand-btn { background: var(--loss-red); }

        .slots-reel-container {
            background: var(--inner-bg);
            border-radius: 16px;
            padding: 25px 15px;
            margin-bottom: 20px;
            border: 1px solid rgba(56, 189, 248, 0.1);
            display: flex;
            justify-content: center;
            gap: 15px;
        }
        .slot-window {
            background: #1e293b;
            font-size: 3.2rem;
            width: 80px;
            height: 80px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            border: 1px solid rgba(255,255,255,0.05);
            box-shadow: inset 0 2px 10px rgba(0,0,0,0.6);
        }
        .spinning { animation: blurAnimation 0.1s infinite alternate; }
        @keyframes blurAnimation { from { filter: blur(1px); transform: scale(0.96); } to { filter: blur(4px); transform: scale(1.04); } }

        .message-board { text-align: center; font-weight: 600; min-height: 24px; margin-top: 15px; font-size: 1rem; color: var(--text-sub); }
        .refill-btn {
            background: transparent; color: var(--text-sub); border: 1px dashed var(--text-sub);
            padding: 12px; border-radius: 12px; margin-top: 15px; width: 100%; max-width: 460px;
            cursor: pointer; font-weight: bold; font-size: 0.9rem;
        }
    </style>
</head>
<body>

    <header>
        <h1>💎 Vanilla Suite</h1>
        <p class="subtitle">Sportsbook, Blackjack & Slots Dashboard</p>
    </header>

