            if (!operationInFlight) {
                document.getElementById('bj-slider-wrapper').style.opacity = '1';
                document.getElementById('deal-btn').style.display = 'block';
                document.getElementById('hit-btn').style.display = 'none';
                document.getElementById('stand-btn').style.display = 'none';
                document.getElementById('deal-btn').disabled = (balance < universalWager);
            }
            
            document.getElementById('slots-btn').disabled = (balance < universalWager || operationInFlight);
        }

