            <div class="hand-section">
                <div class="hand-label">Dealer Hand (<span id="dealer-score">0</span>)</div>
                <div class="card-row" id="dealer-cards"></div>
            </div>
            <div class="hand-section" style="margin-bottom: 0;">
                <div class="hand-label">Your Hand (<span id="player-score">0</span>)</div>
                <div class="card-row" id="player-cards"></div>
            </div>
        </div>
        <div class="slider-zone" id="bj-slider-wrapper">
            <div class="slider-label"><span>Wager Amount:</span><strong><span id="wager-bj-txt">50</span> VC</strong></div>
            <input type="range" id="slider-bj" class="bet-slider" min="10" max="500" step="10" value="50" oninput="syncWagers(this.value)">
        </div>
        <div class="bj-grid">
            <button class="action-btn-main" id="deal-btn" onclick="startBlackjackHand()" style="grid-column: span 2;">Deal Hand</button>
            <button class="split-btn" id="hit-btn" onclick="playerHit()" style="display:none;">Hit</button>
            <button class="split-btn" id="stand-btn" onclick="playerStand()" style="display:none;">Stand</button>
        </div>
        <div class="message-board" id="bj-msg">Place bet and deal cards!</div>
    </div>

    <!-- MODULE 3: SLOTS -->
    <div class="game-card" id="card-slots">
        <div class="slots-reel-container">
            <div class="slot-window" id="reel1">🍇</div>
            <div class="slot-window" id="reel2">🍉</div>
            <div class="slot-window" id="reel3">🍒</div>
        </div>
        <div class="slider-zone">
            <div class="slider-label"><span>Spin Cost:</span><strong><span id="wager-slots-txt">50</span> VC</strong></div>
            <input type="range" id="slider-slots" class="bet-slider" min="10" max="500" step="10" value="50" oninput="syncWagers(this.value)">
        </div>
        <button class="action-btn-main" id="slots-btn" onclick="spinSlots()">Pull Lever</button>
        <div class="message-board" id="slots-msg">Test your luck matching lines.</div>
    </div>

